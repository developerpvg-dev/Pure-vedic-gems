# =============================================================================
# PureVedicGems — Environment Variables Template
# =============================================================================
# Copy to .env.local and fill in your values.
# =============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Phase 4: large /public assets → Storage bucket `site-static` (see npm run site-static:upload)
# Rewrites use NEXT_PUBLIC_SUPABASE_URL automatically — no extra env needed.
DATABASE_URL=

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_WEBHOOK_SECRET=

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend (transactional emails: orders, consultations, enquiries, welcome)
RESEND_API_KEY=
# Branded sender, e.g. PureVedicGems <orders@purevedicgems.com>
EMAIL_FROM=
RESEND_FROM_EMAIL=
# Links in emails (CTAs). Use your public Vercel/production URL — not localhost.
EMAIL_SITE_URL=
# Optional: host for email <img> assets if different from EMAIL_SITE_URL
EMAIL_ASSET_BASE_URL=
# Optional full URL override for the header logo (HTTPS). Default: {EMAIL_SITE_URL}/api/email/logo
EMAIL_LOGO_URL=
EMAIL_WORDMARK_URL=
# Admin inbox for order/booking/enquiry alerts (required in production)
ADMIN_NOTIFICATION_EMAIL=
# Optional sales inbox; falls back to ADMIN_NOTIFICATION_EMAIL
SALES_NOTIFICATION_EMAIL=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Cloudflare Turnstile for contact/enquiry forms (free tier)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames returned by siteverify (prod: purevedicgems.com,www.purevedicgems.com)
TURNSTILE_HOSTNAMES=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=purevedicgems@gmail.com

# Analytics / Search
NEXT_PUBLIC_GA_ID=G-WRGCQVSFWX
NEXT_PUBLIC_META_PIXEL_ID=1669879376585568
GOOGLE_SITE_VERIFICATION=
GOOGLE_MERCHANT_CENTER_ID=

# External rates / scheduled tasks
GOLD_RATE_API_KEY=
CURRENCY_RATE_API_KEY=
CRON_SECRET=
ADMIN_SETUP_SECRET=

# Products Uploading role: reusable team codes after password (comma-separated)
# Default if unset: 847291,392018,615473
INVENTORY_ADMIN_OTP_CODES=

# Ratna AI Agent (Option 1A)
AGENT_ENABLED=false
# Client mount gate — must be true with AGENT_ENABLED or every page hits /api/agent/config
NEXT_PUBLIC_AGENT_ENABLED=false
OPENAI_API_KEY=
AGENT_SESSION_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Primary Twilio number (kept for backwards compat)
TWILIO_PHONE_NUMBER=
# Regional Twilio numbers (all route to the same Ratna voice webhook)
TWILIO_PHONE_NUMBER_US=
TWILIO_PHONE_NUMBER_AU=
TWILIO_PHONE_NUMBER_UAE=
# Public "Call Ratna" numbers shown on site. Format: "US:+1..., AU:+61..., UAE:+971..."
NEXT_PUBLIC_RATNA_CALL_NUMBERS=
PIPECAT_SERVICE_URL=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
BHARATVOICE_API_KEY=
BHARATVOICE_API_BASE_URL=https://api.bharatvoice.ai
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_INBOX_ID=
RATNA_HANDOFF_PHONE=
RATNA_LEAD_SCORE_THRESHOLD=70

# Local QA / Playwright overrides
PLAYWRIGHT_BASE_URL=
PLAYWRIGHT_PORT=3001
PLAYWRIGHT_REUSE_SERVER=0
PLAYWRIGHT_SKIP_BUILD=0
