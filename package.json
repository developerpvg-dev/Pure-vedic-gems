{
  "name": "purevedicgems",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=2048 next dev",
    "dev:clean": "node scripts/clean-dev-cache.mjs && cross-env NODE_OPTIONS=--max-old-space-size=1536 next dev",
    "clean": "node scripts/clean-dev-cache.mjs",
    "build": "cross-env NODE_OPTIONS='--max-old-space-size=3072' next build",
    "prebuild": "node scripts/convert-images-to-webp.mjs",
    "start": "next start",
    "studio": "sanity dev",
    "studio:build": "sanity build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:agent": "vitest run tests/unit/agent.test.ts",
    "test:agent-e2e": "playwright test tests/e2e/agent.spec.ts",
    "agent:eval": "tsx scripts/agent-eval/run-eval.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test tests/e2e/route-smoke.spec.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:perf": "playwright test tests/e2e/performance-budget.spec.ts",
    "legacy:rewards": "tsx scripts/legacy-import/rewards/migrate-rewards.ts",
    "legacy:ring-designs": "tsx scripts/legacy-import/ring-designs/migrate-ring-designs.ts",
    "legacy:pendant-designs": "tsx scripts/legacy-import/pendant-designs/migrate-pendant-designs.ts",
    "legacy:bracelet-designs": "tsx scripts/legacy-import/bracelet-designs/migrate-bracelet-designs.ts",
    "legacy:rudraksha-designs": "tsx scripts/legacy-import/rudraksha-designs/migrate-rudraksha-designs.ts",
    "seed:navratna-reviews": "tsx scripts/seed/generate-navratna-category-reviews.ts",
    "seed:rudraksha-reviews": "tsx scripts/seed/generate-rudraksha-category-reviews.ts",
    "seed:upratna-reviews": "tsx scripts/seed/generate-upratna-category-reviews.ts",
    "seed:catalog-reviews": "tsx scripts/seed/generate-catalog-category-reviews.ts",
    "seed:legacy-users": "tsx scripts/seed/seed-legacy-users.ts --write",
    "security:audit": "npm audit --audit-level=high",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.8",
    "@ai-sdk/react": "^4.0.18",
    "@base-ui/react": "^1.3.0",
    "@react-email/components": "^1.0.10",
    "@sanity/client": "^7.20.0",
    "@sanity/image-url": "^2.0.3",
    "@sentry/nextjs": "^10.45.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.3",
    "@tiptap/extension-placeholder": "^3.22.0",
    "@tiptap/extension-text-align": "^3.22.0",
    "@tiptap/extension-underline": "^3.22.0",
    "@tiptap/pm": "^3.22.0",
    "@tiptap/react": "^3.22.0",
    "@tiptap/starter-kit": "^3.22.0",
    "ai": "^7.0.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-state-city": "^3.2.1",
    "date-fns": "^4.3.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.1",
    "next-sanity": "^12.1.3",
    "next-themes": "^0.4.6",
    "razorpay": "^2.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-simple-maps": "^3.0.0",
    "read-excel-file": "^9.0.9",
    "recharts": "^3.10.0",
    "resend": "^6.9.4",
    "sanity": "^5.17.1",
    "shadcn": "^4.1.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "styled-components": "^6.1.19",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tinycolor2": "^1.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tinycolor2": "^1.4.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^29.1.1",
    "pg": "^8.21.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.6",
    "xlsx": "^0.18.5"
  }
}
