{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pure-vedic-gems",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Run next to Supabase (was Vercel region bom1) — every page does several DB round trips.
  "placement": {
    "mode": "targeted",
    "hostname": "kjsyhuybvzzfpybtlvei.supabase.co"
  },
  // Env vars are managed in the dashboard; don't let deploys wipe them.
  "keep_vars": true,
  "triggers": {
    // Daily product-trash purge (was vercel.json cron). Handled by scheduled() in cloudflare/worker.ts.
    "crons": ["0 3 * * *"]
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "pure-vedic-gems"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "pvg-next-cache"
    },
    {
      // Public media behind cdn.purevedicgems.com (uploads via src/lib/media/r2.ts).
      "binding": "PUBLIC_MEDIA",
      "bucket_name": "pvg-public"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache"
      },
      {
        "name": "NEXT_CACHE_DO_PURGE",
        "class_name": "BucketCachePurge"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache", "BucketCachePurge"]
    }
  ],
  "env": {
    "preview": {
      "name": "pure-vedic-gems-preview",
      // Only production purges trash.
      "triggers": {
        "crons": []
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "pure-vedic-gems-preview"
        }
      ],
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "pvg-next-cache-preview"
        },
        {
          "binding": "PUBLIC_MEDIA",
          "bucket_name": "pvg-public"
        }
      ],
      "browser": {
        "binding": "BROWSER"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "NEXT_CACHE_DO_QUEUE",
            "class_name": "DOQueueHandler"
          },
          {
            "name": "NEXT_TAG_CACHE_DO_SHARDED",
            "class_name": "DOShardedTagCache"
          },
          {
            "name": "NEXT_CACHE_DO_PURGE",
            "class_name": "BucketCachePurge"
          }
        ]
      }
    }
  }
}
