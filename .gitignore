# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# local scratch artifacts (screenshots, build logs, one-off scripts)
/*.png
/build-output.txt
/take-screenshots.mjs
/fix_*.mjs
/fix_*.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent customization folders
.agents/
.claude/

# legacy import local cache (raw SQL extracts and downloaded media)
/scripts/legacy-import/_raw/

# Legacy blog migration image upload cache
scripts/legacy-import/blogs/.image-cache.json
