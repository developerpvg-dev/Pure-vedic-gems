<script>
//var jq = $.noConflict();
jQuery(document).ready(function(){
	var skipSlider3 = document.getElementById('range-slider-3');
	noUiSlider.create(skipSlider3, {
		range: {
			'min': 2.00,
			'4%': 2.25,
			'8%': 2.50,
			'12%': 3.00,
			'15%': 3.25,
			'18%': 3.50,
