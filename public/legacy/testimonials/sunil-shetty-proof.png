			'28%': 5.00,
			'30%': 5.25,
			'33%': 5.50,
			'35%': 6.00,
			'38%': 6.25,
			'40%': 6.50,
			'43%': 7.00,
			'45%': 7.25,
			'48%': 7.50,
			'50%': 8.00,
			'53%': 8.25,
			'55%': 8.50,
			'57%': 9.00,
			'60%': 9.25,
			'63%': 9.50,
			'65%': 10.00,
			'68%': 10.25,
			'70%': 10.50,
			'72%': 11.00,
